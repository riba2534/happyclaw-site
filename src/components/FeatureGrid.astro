---
const features = [
  { icon: '⚙️', title: '原生 Claude Code 运行时', desc: '完整 CLI 运行时，继承 Claude Code 的全部能力，上游升级无需适配。' },
  { icon: '🔀', title: '六端 IM 统一接入', desc: '飞书、钉钉、微信、QQ、Telegram、Web 消息统一路由。' },
  { icon: '🔒', title: 'Per-user 完全隔离', desc: '独立工作区、IM 通道和会话记忆，多用户互不干扰。' },
  { icon: '📱', title: '移动端 PWA', desc: 'iOS 和 Android 均可安装到桌面，小屏功能完整。' },
  { icon: '🧰', title: 'MCP / Skill 接入', desc: '接入外部开源生态，Agent 与主进程双向通信。' },
  { icon: '⏰', title: '定时任务调度', desc: '支持 Cron、固定间隔和一次性执行，附完整执行日志。' },
  { icon: '🧠', title: '四层记忆系统', desc: '用户全局、会话、日期等多层记忆，支持全文检索和跨会话持久化。' },
  { icon: '📦', title: '40+ 工具链容器', desc: '预装 Node.js、Python、Chromium、ffmpeg 等等，Docker 隔离执行。' },
  { icon: '🛡️', title: '企业级安全', desc: 'RBAC 权限、AES-256-GCM 加密、审计日志、邀请码注册。' },
  { icon: '📊', title: '自建计费与用量', desc: '内建用量统计和计费，多用户成本可按人核算。' },
  { icon: '🐳', title: 'Docker 一键私有化', desc: 'git clone、make start 三步部署进内网。' },
  { icon: '⚖️', title: '多 Provider 负载均衡', desc: '不绑定单一模型厂商，多个 Provider 之间可自由切换并做负载均衡。' },
];
---

<section class="section-pad" style="max-width:1200px;margin:0 auto;padding:40px 28px 60px;">
  <div data-reveal style="text-align:center;margin-bottom:44px;">
    <div
      style="font-size:12px;letter-spacing:0.18em;color:var(--accent);font-weight:600;margin-bottom:14px;"
    >
      平台能力 · CAPABILITIES
    </div>
    <h2
      style="font-size:clamp(28px, 3.6vw, 44px);font-weight:700;letter-spacing:-0.02em;margin:0;color:#0b0b10;"
    >
      面向多用户企业部署的完整能力栈
    </h2>
  </div>

  <div class="grid-3" style="display:grid;grid-template-columns:repeat(3, 1fr);gap:16px;">
    {
      features.map((f) => (
        <div
          data-reveal
          style="border:1px solid rgba(0,0,0,0.08);border-radius:14px;padding:24px;background:#fff;transition:border-color .25s, box-shadow .25s;"
        >
          <div style="font-size:22px;margin-bottom:12px;">{f.icon}</div>
          <h3
            style="font-size:16.5px;font-weight:600;margin:0 0 8px;letter-spacing:-0.01em;color:#0b0b10;"
          >
            {f.title}
          </h3>
          <p style="font-size:13.5px;line-height:1.55;color:#6f6f7b;margin:0;">{f.desc}</p>
        </div>
      ))
    }
  </div>
</section>
