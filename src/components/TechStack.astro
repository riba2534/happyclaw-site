---
const techs = [
  { name: 'Node.js', color: '#339933', icon: 'N' },
  { name: 'TypeScript', color: '#3178C6', icon: 'TS' },
  { name: 'React', color: '#61DAFB', icon: 'R' },
  { name: 'Vite', color: '#646CFF', icon: 'V' },
  { name: 'Tailwind CSS', color: '#06B6D4', icon: 'T' },
  { name: 'Docker', color: '#2496ED', icon: 'D' },
  { name: 'SQLite', color: '#003B57', icon: 'S' },
  { name: 'Hono', color: '#E36002', icon: 'H' },
  { name: 'Claude SDK', color: '#0d9488', icon: 'C' },
  { name: 'Zustand', color: '#443E35', icon: 'Z' },
];
---

<section class="py-24 px-4">
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">技术栈</h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 max-w-4xl mx-auto">
    {techs.map((tech) => (
      <div
        class="glass-card p-6 flex flex-col items-center gap-3 transition-colors"
        style={`--hover-color: ${tech.color}30;`}
        data-color={tech.color}
      >
        <div
          class="w-12 h-12 rounded-xl flex items-center justify-center text-xl font-bold"
          style={`background: ${tech.color}20; color: ${tech.color};`}
        >
          {tech.icon}
        </div>
        <span class="text-sm text-slate-300 font-medium">{tech.name}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .glass-card:hover {
    border-color: var(--hover-color);
  }
</style>
