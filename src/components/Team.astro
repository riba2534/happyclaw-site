---
const team = [
  { name: '字节系技术班底', role: 'Engineering', note: '核心成员来自字节一线团队。' },
  { name: '全栈平台工程', role: 'Platform', note: '运行时到私有化端到端工程。' },
  { name: 'Agent 架构', role: 'Architecture', note: '多用户调度与记忆体系架构。' },
  { name: '产品与商业化', role: 'Product & GTM', note: '体验设计、品牌与企业拓展。' },
  { name: '开源社区', role: 'Open Source', note: '活跃贡献者,社区驱动迭代。' },
  { name: '顶尖高校背景', role: 'Research', note: '北大、川大、港理工等背景。' },
];
---

<section class="section-pad" style="max-width:1200px;margin:0 auto;padding:80px 28px;">
  <div data-reveal style="max-width:760px;margin:0 0 44px;">
    <div
      style="font-size:12px;letter-spacing:0.18em;color:var(--accent);font-weight:600;margin-bottom:14px;"
    >
      团队 · TEAM
    </div>
    <h2
      style="font-size:clamp(28px, 3.6vw, 44px);font-weight:700;letter-spacing:-0.02em;margin:0 0 12px;color:#0b0b10;"
    >
      一支字节出身、技术 × 产品双核的实战团队
    </h2>
  </div>

  <div class="grid-3" style="display:grid;grid-template-columns:repeat(3, 1fr);gap:16px;">
    {
      team.map((t) => (
        <div
          data-reveal
          style="border:1px solid rgba(0,0,0,0.08);border-radius:14px;padding:22px;background:#fff;"
        >
          <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:6px;flex-wrap:wrap;">
            <h3 style="font-size:17px;font-weight:700;margin:0;color:#0b0b10;">{t.name}</h3>
            <span style="font-size:12.5px;color:var(--accent);font-weight:600;">{t.role}</span>
          </div>
          <p style="font-size:13.5px;line-height:1.55;color:#6f6f7b;margin:0;">{t.note}</p>
        </div>
      ))
    }
  </div>
</section>
