---
const links = [
  { href: 'https://happyclaw.cc', label: '官网', ext: true },
  { href: 'https://claw.shakaka.xyz', label: '在线试用', ext: true },
  { href: 'https://github.com/riba2534/happyclaw', label: 'GitHub', ext: true },
  { href: 'https://github.com/riba2534/happyclaw/blob/main/LICENSE', label: 'License', ext: true },
  { href: 'mailto:business@happyclaw.cc?subject=HappyClaw%20企业咨询', label: 'business@happyclaw.cc', ext: false },
];
---

<footer style="border-top:1px solid rgba(0,0,0,0.07);">
  <div
    class="section-pad footer-flex"
    style="max-width:1200px;margin:0 auto;padding:40px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;"
  >
    <div style="display:flex;align-items:center;gap:10px;font-weight:700;font-size:17px;color:#0b0b10;">
      <img
        src="/assets/logo-full-dark.svg"
        alt="HappyClaw"
        style="height:40px;width:auto;display:block;"
      />
      <span style="font-weight:400;font-size:13px;color:#a3a3ad;margin-left:6px;">
        AI 时代的企业级 Agent OS
      </span>
    </div>

    <div style="display:flex;gap:22px;font-size:14px;color:#63636e;flex-wrap:wrap;">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.ext ? '_blank' : undefined}
            rel={l.ext ? 'noopener' : undefined}
            style="transition:color .2s;"
            onmouseover="this.style.color='#0b0b10'"
            onmouseout="this.style.color='#63636e'"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div style="font-size:13px;color:#a3a3ad;">MIT License · © 2026 HappyClaw</div>
  </div>
</footer>
