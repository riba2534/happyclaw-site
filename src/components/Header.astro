---
const links = [
  { href: '#platform', label: '产品 Platform' },
  { href: '#why', label: '为什么私有化' },
  { href: '#projects', label: '落地案例' },
  { href: '#opensource', label: '开源' },
];
---

<nav
  id="hc-nav"
  class="hc-nav"
  style="position:fixed;top:0;left:0;right:0;z-index:50;background:transparent;border-bottom:1px solid transparent;transition:background .3s ease, border-color .3s ease;"
>
  <div style="max-width:1200px;margin:0 auto;padding:18px 24px;display:flex;align-items:center;gap:28px;">
    <a href="#top" data-navlink style="display:flex;align-items:center;">
      <img
        id="hc-logo"
        src="/assets/logo-full.svg"
        alt="HappyClaw"
        style="height:44px;width:auto;display:block;"
      />
    </a>
    <div class="hc-nav-links" style="display:flex;align-items:center;gap:30px;margin-left:auto;font-size:14px;">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-navlink
            class="hc-nav-hide"
            style="color:rgba(255,255,255,0.92);transition:color .3s ease, opacity .2s ease;opacity:.9;"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="https://github.com/riba2534/happyclaw"
        target="_blank"
        rel="noopener"
        data-navlink
        class="hc-nav-hide"
        style="color:rgba(255,255,255,0.92);transition:color .3s ease;opacity:.9;"
      >
        GitHub
      </a>
      <a
        href="mailto:business@happyclaw.cc?subject=HappyClaw%20企业咨询"
        data-navlink
        class="hc-nav-hide"
        style="color:rgba(255,255,255,0.92);transition:color .3s ease;opacity:.9;"
      >
        联系商务
      </a>
      <a
        id="hc-navbtn"
        href="https://claw.shakaka.xyz"
        target="_blank"
        rel="noopener"
        class="hc-nav-cta"
        style="background:#ffffff;color:#0b0b10;font-weight:600;padding:9px 18px;border-radius:10px;transition:transform .15s, background .3s ease, color .3s ease;"
      >
        在线试用
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('hc-nav') as HTMLElement | null;
  const logo = document.getElementById('hc-logo') as HTMLImageElement | null;
  const btn = document.getElementById('hc-navbtn') as HTMLElement | null;
  const links = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-navlink]')) : [];
  const header = document.querySelector<HTMLElement>('#top');

  let solid: boolean | null = null;
  const apply = (s: boolean) => {
    if (!nav || s === solid) return;
    solid = s;
    if (s) {
      nav.style.background = 'rgba(255,255,255,0.85)';
      nav.style.backdropFilter = 'blur(14px)';
      nav.style.setProperty('-webkit-backdrop-filter', 'blur(14px)');
      nav.style.borderBottomColor = 'rgba(0,0,0,0.07)';
      links.forEach((a) => {
        a.style.color = a.getAttribute('href') === '#top' ? '#0b0b10' : '#55555f';
      });
      if (logo) logo.src = '/assets/logo-full-dark.svg';
      if (btn) {
        btn.style.background = 'var(--accent)';
        btn.style.color = '#fff';
      }
    } else {
      nav.style.background = 'transparent';
      nav.style.backdropFilter = 'none';
      nav.style.setProperty('-webkit-backdrop-filter', 'none');
      nav.style.borderBottomColor = 'transparent';
      links.forEach((a) => {
        a.style.color = a.getAttribute('href') === '#top' ? '#ffffff' : 'rgba(255,255,255,0.92)';
      });
      if (logo) logo.src = '/assets/logo-full.svg';
      if (btn) {
        btn.style.background = '#ffffff';
        btn.style.color = '#0b0b10';
      }
    }
  };

  let tick = false;
  const onScroll = () => {
    if (tick) return;
    tick = true;
    requestAnimationFrame(() => {
      const thr = header ? header.offsetHeight - 72 : 240;
      apply(window.scrollY > thr);
      tick = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();
</script>
