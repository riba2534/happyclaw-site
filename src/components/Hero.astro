---
---
<section id="hero" class="min-h-screen relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900 to-teal-950">
  <!-- Floating blobs -->
  <div class="absolute top-20 left-10 w-[400px] h-[400px] rounded-full bg-teal-500/10 blur-3xl animate-drift"></div>
  <div class="absolute top-60 right-20 w-[350px] h-[350px] rounded-full bg-amber-500/10 blur-3xl animate-drift delay-300"></div>
  <div class="absolute bottom-40 left-1/3 w-[500px] h-[500px] rounded-full bg-purple-500/10 blur-3xl animate-drift delay-500"></div>
  <div class="absolute bottom-20 right-10 w-[300px] h-[300px] rounded-full bg-teal-400/15 blur-3xl animate-drift delay-100"></div>

  <!-- Content -->
  <div class="relative z-10 flex items-center justify-center flex-col pt-32 pb-20 min-h-screen px-4">
    <div class="animate-fade-in-up flex flex-col items-center text-center">
      <img
        src="/logo.png"
        alt="HappyClaw Logo"
        class="w-24 h-24 md:w-32 md:h-32 rounded-2xl shadow-2xl mb-8"
      />
      <h1 class="text-5xl md:text-7xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-300">
        HappyClaw
      </h1>
      <p class="text-xl md:text-2xl text-teal-400 font-medium mt-4">
        自托管多用户 AI Agent 系统
      </p>
      <p class="text-slate-400 text-base md:text-lg mt-4 max-w-2xl text-center">
        基于 Claude Code 驱动，通过飞书、Telegram 和 Web 随时访问
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <a
          href="#quickstart"
          class="bg-teal-600 hover:bg-teal-500 text-white px-8 py-3 rounded-xl font-semibold transition-all text-center"
        >
          快速开始
        </a>
        <a
          href="https://github.com/riba2534/happyclaw"
          target="_blank"
          rel="noopener"
          class="border border-white/20 hover:border-white/40 text-white px-8 py-3 rounded-xl font-semibold transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>
