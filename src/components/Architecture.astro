---
const techTags = [
  'Node.js', 'TypeScript', 'Hono', 'React', 'Vite',
  'Tailwind', 'Docker', 'SQLite', 'Claude SDK', 'Zustand',
];
---

<section class="py-24 px-4">
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">技术架构</h2>

  <div class="max-w-4xl mx-auto">
    <svg viewBox="0 0 800 520" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" role="img" aria-label="HappyClaw 技术架构图">
      <!-- Arrowhead marker (defined first) -->
      <defs>
        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
          <polygon points="0 0, 10 3.5, 0 7" fill="#5eead4" />
        </marker>
      </defs>

      <!-- Layer 1: Access Layer -->
      <rect x="80" y="15" width="640" height="65" rx="12" fill="#2dd4bf08" stroke="#2dd4bf" stroke-width="1" stroke-opacity="0.3" />
      <text x="60" y="52" text-anchor="end" fill="#2dd4bf" font-size="12" font-weight="bold" font-family="system-ui, sans-serif">接入层</text>

      <rect x="120" y="28" width="160" height="40" rx="8" fill="#2dd4bf15" stroke="#2dd4bf" stroke-width="1" stroke-opacity="0.25" />
      <text x="200" y="53" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">飞书</text>

      <rect x="320" y="28" width="160" height="40" rx="8" fill="#2dd4bf15" stroke="#2dd4bf" stroke-width="1" stroke-opacity="0.25" />
      <text x="400" y="53" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">Telegram</text>

      <rect x="520" y="28" width="160" height="40" rx="8" fill="#2dd4bf15" stroke="#2dd4bf" stroke-width="1" stroke-opacity="0.25" />
      <text x="600" y="53" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">Web UI</text>

      <!-- Arrows: Access -> Main Process -->
      <line x1="200" y1="80" x2="280" y2="115" stroke="#5eead4" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />
      <line x1="400" y1="80" x2="400" y2="115" stroke="#5eead4" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />
      <line x1="600" y1="80" x2="520" y2="115" stroke="#5eead4" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />

      <!-- Layer 2: Main Process -->
      <rect x="80" y="115" width="640" height="80" rx="12" fill="#14b8a608" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.3" />
      <text x="60" y="160" text-anchor="end" fill="#14b8a6" font-size="12" font-weight="bold" font-family="system-ui, sans-serif">主进程</text>

      <rect x="105" y="132" width="130" height="40" rx="8" fill="#14b8a615" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.25" />
      <text x="170" y="157" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">路由分发</text>

      <rect x="255" y="132" width="130" height="40" rx="8" fill="#14b8a615" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.25" />
      <text x="320" y="157" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">任务队列</text>

      <rect x="405" y="132" width="130" height="40" rx="8" fill="#14b8a615" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.25" />
      <text x="470" y="157" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">会话调度</text>

      <rect x="555" y="132" width="140" height="40" rx="8" fill="#14b8a615" stroke="#14b8a6" stroke-width="1" stroke-opacity="0.25" />
      <text x="625" y="157" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">WebSocket</text>

      <!-- Arrows: Main Process -> Execution -->
      <line x1="300" y1="195" x2="280" y2="225" stroke="#14b8a6" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />
      <line x1="500" y1="195" x2="520" y2="225" stroke="#14b8a6" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />

      <!-- Layer 3: Execution Layer -->
      <rect x="80" y="225" width="640" height="65" rx="12" fill="#0d948808" stroke="#0d9488" stroke-width="1" stroke-opacity="0.3" />
      <text x="60" y="262" text-anchor="end" fill="#0d9488" font-size="12" font-weight="bold" font-family="system-ui, sans-serif">执行层</text>

      <rect x="140" y="238" width="240" height="40" rx="8" fill="#0d948815" stroke="#0d9488" stroke-width="1" stroke-opacity="0.25" />
      <text x="260" y="263" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">宿主机进程</text>

      <rect x="420" y="238" width="240" height="40" rx="8" fill="#0d948815" stroke="#0d9488" stroke-width="1" stroke-opacity="0.25" />
      <text x="540" y="263" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">Docker 沙箱</text>

      <!-- Arrows: Execution -> Agent Runtime -->
      <line x1="260" y1="290" x2="310" y2="325" stroke="#0d9488" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />
      <line x1="540" y1="290" x2="490" y2="325" stroke="#0d9488" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />

      <!-- Layer 4: Agent Runtime -->
      <rect x="80" y="325" width="640" height="65" rx="12" fill="#0f766e08" stroke="#0f766e" stroke-width="1" stroke-opacity="0.3" />
      <text x="60" y="362" text-anchor="end" fill="#5eead4" font-size="12" font-weight="bold" font-family="system-ui, sans-serif">运行时</text>

      <rect x="145" y="338" width="160" height="40" rx="8" fill="#0f766e15" stroke="#0f766e" stroke-width="1" stroke-opacity="0.25" />
      <text x="225" y="363" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">Claude Agent SDK</text>

      <rect x="325" y="338" width="150" height="40" rx="8" fill="#0f766e15" stroke="#0f766e" stroke-width="1" stroke-opacity="0.25" />
      <text x="400" y="363" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">MCP Tools</text>

      <rect x="495" y="338" width="160" height="40" rx="8" fill="#0f766e15" stroke="#0f766e" stroke-width="1" stroke-opacity="0.25" />
      <text x="575" y="363" text-anchor="middle" fill="#d1d5db" font-size="12" font-family="system-ui, sans-serif">流式输出</text>

      <!-- Arrows: Agent Runtime -> Storage -->
      <line x1="400" y1="390" x2="400" y2="425" stroke="#0f766e" stroke-width="1.5" stroke-opacity="0.5" marker-end="url(#arrowhead)" />

      <!-- Layer 5: Storage -->
      <rect x="80" y="425" width="640" height="65" rx="12" fill="#115e5908" stroke="#115e59" stroke-width="1" stroke-opacity="0.3" />
      <text x="60" y="462" text-anchor="end" fill="#5eead4" font-size="12" font-weight="bold" font-family="system-ui, sans-serif">存储层</text>

      <rect x="130" y="438" width="170" height="40" rx="8" fill="#115e5915" stroke="#115e59" stroke-width="1" stroke-opacity="0.25" />
      <text x="215" y="463" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">SQLite</text>

      <rect x="320" y="438" width="170" height="40" rx="8" fill="#115e5915" stroke="#115e59" stroke-width="1" stroke-opacity="0.25" />
      <text x="405" y="463" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">会话记忆</text>

      <rect x="510" y="438" width="170" height="40" rx="8" fill="#115e5915" stroke="#115e59" stroke-width="1" stroke-opacity="0.25" />
      <text x="595" y="463" text-anchor="middle" fill="#d1d5db" font-size="13" font-family="system-ui, sans-serif">文件系统</text>
    </svg>
  </div>

  <!-- Tech Stack Tags -->
  <div class="flex flex-wrap justify-center gap-3 mt-12">
    {techTags.map((tag) => (
      <span class="px-4 py-1.5 rounded-full text-sm font-medium border border-teal-500/20 bg-teal-500/10 text-teal-300">
        {tag}
      </span>
    ))}
  </div>
</section>
